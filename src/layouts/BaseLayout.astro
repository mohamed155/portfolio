---
// Level 0 foundation layout. Head, fonts, the blocking theme script, tokens,
// and a bare slot — nothing visible. PageLayout (header/footer/status-bar
// chrome) composes this at Level 4; do not add visible markup here.
import { ClientRouter } from 'astro:transitions';
import { themeInit } from '../lib/theme-init';
import { bootGateInit } from '../lib/boot-gate';
import { SITE } from '../lib/site';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Root-relative or absolute path to the social preview image. Defaults to the sitewide card. */
  image?: string;
  /** Open Graph type — 'website' for index-style pages, 'article' for case studies. */
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image = '/og-image.png', type = 'website', noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Blocking, runs before first paint. Must stay before any stylesheet. -->
    <script is:inline set:html={themeInit} />
    <script is:inline set:html={bootGateInit} />

    <!-- Preload only what the first screen paints: Space Mono 700, IBM Plex Mono 400. -->
    <link rel="preload" href="/fonts/space-mono-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />
  </head>
  <body>
    <slot />

    <script>
      import '../lib/reveal';

      // BootSequence's cold-load gate needs to tell a fresh visit from a
      // View-Transitions navigation — sessionStorage alone can't, since
      // Astro keeps the document alive across navigations.
      document.addEventListener('astro:after-swap', () => {
        sessionStorage.setItem('mr-navigated', '1');

        // Astro persists <html> across a swap, so a stale data-boot="run"
        // from the initial load would otherwise reapply to the fresh
        // #mr-boot-fallback markup if the user navigates back to "/".
        document.documentElement.removeAttribute('data-boot');

        // ClientRouter swaps <html>'s attributes to match the incoming
        // page's static markup, which never has data-theme baked in (it's
        // only ever set at runtime by theme-init.ts's inline <head> script,
        // which doesn't re-run on a soft navigation). Without this, every
        // client-side navigation drops back to the dark default regardless
        // of the stored preference.
        try {
          const t = localStorage.getItem('mr-theme');
          document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
        } catch {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Space Mono";
    src: url("/fonts/space-mono-700.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/ibm-plex-mono-400.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }
</style>
