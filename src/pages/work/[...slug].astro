---
// Level 5 page. One case study per collection entry, rendered through
// CaseStudyLayout. `hero.src` / `features[].shot.src` are optional strings
// in the schema — resolved here (not in the template, see
// content-collections.md's Images section). A path under src/assets is
// resolved to ImageMetadata via import.meta.glob for the optimized pipeline;
// a `/images/...` path is a public/ asset and passes through as a plain
// string, which ScreenshotFrame renders as an unoptimized <img>.
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp,avif}');

async function resolve(src?: string): Promise<ImageMetadata | string | undefined> {
  if (!src) return undefined;
  const loader = images[src];
  if (loader) return (await loader()).default;
  return src;
}

export async function getStaticPaths() {
  const entries = await getCollection('case-studies', ({ data }) => !data.draft);
  return entries
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const heroSrc = await resolve(entry.data.hero.src);
const features = await Promise.all(
  entry.data.features.map(async (f) => ({ ...f, shot: { ...f.shot, src: await resolve(f.shot.src) } }))
);

const data = { ...entry.data, hero: { ...entry.data.hero, src: heroSrc }, features };
---

<CaseStudyLayout data={data}>
  <Content />
</CaseStudyLayout>
