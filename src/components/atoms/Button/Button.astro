---
interface Props {
  variant?: 'solid' | 'outline' | 'ghost' | 'quiet';
  size?: 'sm' | 'md';
  href?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
}

const { variant = 'solid', size = 'md', href, target, rel, disabled = false, class: className } = Astro.props;

const variantClass: Record<string, string> = {
  solid: 'border-transparent bg-ac text-acfg hover:bg-fg hover:text-bg',
  outline: 'border-bd2 bg-transparent text-fg hover:border-fg hover:bg-fg hover:text-bg',
  ghost: 'border-transparent bg-transparent text-fg2 hover:text-ac',
  quiet: 'border-bd bg-transparent text-fg2 hover:border-ac hover:text-ac',
};

const sizeClass: Record<string, string> = {
  sm: variant === 'ghost' ? 'h-8 px-2 text-[11px] tracking-[.08em]' : 'h-8 px-[11px] text-[11px] tracking-[.08em]',
  md: variant === 'ghost' ? 'py-[14px] px-4 text-ui-sm tracking-caps' : 'py-[14px] px-5 text-ui-sm tracking-caps',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={rel}
  type={Tag === 'button' ? 'button' : undefined}
  disabled={Tag === 'button' && disabled ? true : undefined}
  aria-disabled={Tag === 'a' && disabled ? 'true' : undefined}
  tabindex={Tag === 'a' && disabled ? -1 : undefined}
  class:list={[
    'inline-flex items-center gap-[10px] border font-medium uppercase transition-[background-color,color,border-color] duration-200',
    variantClass[variant],
    sizeClass[size],
    disabled && 'pointer-events-none opacity-40 cursor-not-allowed',
    className,
  ]}
>
  <slot />
</Tag>
