---
interface Props {
  index: string;
  title: string;
  meta?: string;
  strong?: boolean;
  class?: string;
}

const { index, title, meta, strong = false, class: className } = Astro.props;
---

<div
  class:list={[
    'flex items-baseline gap-[18px] border-b pb-[14px]',
    strong ? 'border-b-bd2' : 'border-b-bd',
    className,
  ]}
>
  <span class="text-[11px] tracking-caps text-ac">{index}</span>
  <h2 class="font-display text-body-xs font-bold uppercase tracking-caps-widest text-fg">{title}</h2>
  {meta && <span class="ml-auto text-label-sm tracking-caps text-fg3">{meta}</span>}
</div>
