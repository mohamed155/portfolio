---
// Presentational only — no ThemeToggle.island.tsx exists. State belongs to
// Header, which hand-rolls the equivalent interactive markup in JSX because
// a React island cannot import an .astro component.
import Button from '../../atoms/Button/Button.astro';

interface Props {
  theme: 'dark' | 'light';
  class?: string;
}

const { theme, class: className } = Astro.props;
---

<Button variant="quiet" size="sm" class={className}>
  <span class="h-2 w-2 flex-none bg-ac" aria-hidden="true"></span>
  <span class="to-xs:hidden">{theme === 'light' ? 'paper' : 'dark'}</span>
</Button>
