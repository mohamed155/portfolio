---
import Monogram from '../../molecules/Monogram/Monogram.astro';
import { SITE } from '../../../lib/site';
---

<footer class="border-t border-t-bd2">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-[18px] px-8 pb-14 pt-[26px] to-xs:px-[18px]">
    <span class="flex items-center gap-[11px]">
      <Monogram size="footer" />
      <span class="text-label tracking-nav text-fg3">mohamed ramadan · senior frontend engineer · built with Astro</span>
    </span>
    <span class="flex gap-4 text-label uppercase tracking-caps">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-ac hover:text-fg">github</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="text-ac hover:text-fg">linkedin</a>
      <a href={`mailto:${SITE.email}`} class="text-ac hover:text-fg">email</a>
    </span>
  </div>
</footer>
