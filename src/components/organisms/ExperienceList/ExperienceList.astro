---
// Owns the role history. All 11 roles, real content ported verbatim from
// Portfolio v2.dc.html's `roles` array.
import SectionHeader from '../../molecules/SectionHeader/SectionHeader.astro';
import ExperienceRow from '../ExperienceRow/ExperienceRow.astro';
import { ROLES } from '../../../lib/roles';
---

<section id="experience" data-section="experience" class="border-t border-t-bd2 py-[84px]">
  <SectionHeader index="03" title="experience" meta="11 roles · 7+ yrs" class="mb-2" />
  <ol class="m-0 list-none p-0">
    {ROLES.map((r) => <ExperienceRow {...r} />)}
  </ol>
</section>
