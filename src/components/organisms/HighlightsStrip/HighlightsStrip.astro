---
// The 4-up strip beneath the hero. Owns the border-top/border-bottom bd2
// rule that StatTile deliberately leaves to its container.
import StatTile from '../../molecules/StatTile/StatTile.astro';

const HIGHLIGHTS = [
  { index: '01', value: '7+ Years', label: 'software engineering', description: '11 roles across banking, media, telecom and enterprise products.' },
  { index: '02', value: 'System Design', label: '16 decision records', description: 'A Rust modular monolith of 23 domain modules, with tenancy, auth, queueing and realtime each decided in a written ADR.' },
  { index: '03', value: 'Multi-tenant SaaS', label: 'isolation by construction', description: 'Shared schema with Row-Level Security, tenant-scoped transactions, and a suite that runs requests against the wrong tenant.' },
  { index: '04', value: 'Frontend Architecture', label: 'angular at scale', description: 'Feature boundaries enforced by lint rules, NgRx and SignalStore state ownership, bundle budgets checked in CI.' },
];
---

<div class="grid grid-cols-4 border-t border-t-bd2 border-b border-b-bd2 to-lg:grid-cols-2 to-xs:grid-cols-1">
  {HIGHLIGHTS.map((h) => (
    <div data-reveal>
      <StatTile index={h.index} value={h.value} label={h.label}>{h.description}</StatTile>
    </div>
  ))}
</div>
