---
// The 4-up strip beneath the hero. Owns the border-top/border-bottom bd2
// rule that StatTile deliberately leaves to its container.
import StatTile from '../../molecules/StatTile/StatTile.astro';

const HIGHLIGHTS = [
  { index: '01', value: '7+ Years', label: 'software engineering', description: 'Building complex web platforms and enterprise frontend systems.' },
  { index: '02', value: 'Frontend Architecture', label: 'scalable systems', description: 'Modular component trees, reactive state, and tokenised design systems.' },
  { index: '03', value: 'Angular Specialist', label: 'modern angular', description: 'Signals, RxJS streams, decoupled state and micro-frontend structure.' },
  { index: '04', value: 'Full Stack + AI', label: 'supporting capabilities', description: 'Rust (Axum), NestJS, PostgreSQL vector search and local model orchestration.' },
];
---

<div class="grid grid-cols-4 border-t border-t-bd2 border-b border-b-bd2 to-lg:grid-cols-2 to-xs:grid-cols-1">
  {HIGHLIGHTS.map((h) => (
    <StatTile index={h.index} value={h.value} label={h.label}>{h.description}</StatTile>
  ))}
</div>
