---
// Typed prompt/name/role line is an island (Hero.island.tsx) — it owns the
// intro typing animation and, once it finishes, reveals the four
// [data-hero-reveal] blocks below in sequence. Everything else here is
// static; client:load per interactivity.md (must respond immediately,
// SSR-safe by starting fully typed).
import Button from '../../atoms/Button/Button.astro';
import Panel from '../../molecules/Panel/Panel.astro';
import ProfilePanel from '../ProfilePanel/ProfilePanel.astro';
import HighlightsStrip from '../HighlightsStrip/HighlightsStrip.astro';
import HeroIntro from './Hero.island.tsx';
---

<section id="top" class="pt-[72px]">
  <HeroIntro client:load />

  <div class="grid grid-cols-[1.15fr_.85fr] items-start gap-[56px] pt-9 pb-16 to-xl:grid-cols-1 to-xl:gap-10">
    <div>
      <p data-hero-reveal class="max-w-[62ch] text-[clamp(14px,1.15vw,16px)] leading-[1.85] text-fg2">
        I design software systems and build them end to end: service boundaries, tenancy and data
        models, async and realtime flows, and the Angular applications on top. Eight years of
        senior frontend work across banking, media and telecom, and a multi-tenant AI platform
        architected from the first decision record to the deploy runbook.
      </p>

      <div data-hero-reveal class="mt-[28px] max-w-[62ch]">
        <Panel label="note">&ldquo;I write the decision down before I write the code. Every boundary has a reason and a recorded trade-off.&rdquo;</Panel>
      </div>

      <div data-hero-reveal class="mt-[28px] flex flex-wrap gap-[10px]">
        <Button href="#work">explore work &rarr;</Button>
        <Button variant="outline" href="#contact">let&rsquo;s talk</Button>
      </div>
    </div>

    <div data-hero-reveal>
      <ProfilePanel />
    </div>
  </div>

  <HighlightsStrip />
</section>
